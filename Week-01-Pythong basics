subjects = ["Math", "Science", "Music", "Computer Science"]
name = input("Please enter your student name: ")

scores = []
for subject in subjects:
    score = float(input(f"Please enter your score for {subject}: "))
    scores.append(score)

average = sum(scores) / len(scores)

print(f"Your name is {name}")

for subject, score in zip(subjects, scores):
    print(f"Your score in {subject} is {score}")

print(f"Your average score is {average:.2f}")



